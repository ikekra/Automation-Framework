NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/autoforge_ai
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=autoforge_refresh
BCRYPT_SALT_ROUNDS=12
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
MOCK_AI=false
MOCK_EMAIL=true
APP_BASE_URL=http://localhost:5000
FRAMEWORK_DOWNLOAD_TTL_MINUTES=30
EMAIL_FROM=no-reply@autoforge.local
EMAIL_VERIFY_TTL_HOURS=24
EMAIL_OTP_TTL_MINUTES=10
